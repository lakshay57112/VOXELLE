# Gnani (Vachana) API key, used for Prisma (speech to text) and Timbre (text to speech)
GNANI_API_KEY=

# Prisma language code (BCP-47). hi-IN works well for Hindi/Hinglish speech.
STT_LANGUAGE=hi-IN

# Timbre settings. Voices are per model, see the Voice Catalog in the Gnani docs.
TTS_MODEL=timbre-v2.5
TTS_VOICE=Poorvi
TTS_LANGUAGE=hi-en
TTS_SPEED=0.95

# Web push (run: python scripts/gen_vapid.py, it fills these in)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=data/vapid_private.pem
# Put your own email here, push services get it as the sender contact
VAPID_SUBJECT=mailto:you@example.com

# Reminder timing
APP_TZ=Asia/Kolkata
REMIND_EVERY_MIN=10
MAX_REMINDERS=3
MISSED_AFTER_MIN=30
DUE_WINDOW_MIN=90
